    {
      "name": "02. Dashboard",
      "item": [
        {
          "name": "Get Summary KPIs (Filtered by Date & Branch)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/summary?from=2026-01-01&to=2026-12-31&branchId=branch-colombo",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "summary"],
              "query": [
                {
                  "key": "from",
                  "value": "2026-01-01"
                },
                {
                  "key": "to",
                  "value": "2026-12-31"
                },
                {
                  "key": "branchId",
                  "value": "branch-colombo"
                }
              ]
            },
            "description": "Returns 6 primary KPIs: totalTickets, openTickets, resolvedTickets, avgResolutionTimeHours, transactionTotal (completed only), and transactionCount."
