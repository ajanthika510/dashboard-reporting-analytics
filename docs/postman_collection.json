                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Monthly High Priority Tickets by Branch\",\n  \"dataset\": \"ServiceTicket\",\n  \"configJson\": {\n    \"dimension\": \"branch\",\n    \"metric\": \"count\",\n    \"filters\": { \"priority\": \"HIGH\" }\n  },\n  \"visibility\": \"SHARED\"\n}"
