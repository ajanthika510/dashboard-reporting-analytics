# Database Connection String (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/dashboard_reporting_analytics?schema=public"

# JWT Secret for access token signing and verification
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# Application Port (Default: 3000)
PORT=3000

# Seed Administrator Credentials (optional overrides)
ADMIN_EMAIL="admin@neirahtech.com"
ADMIN_NAME="System Administrator"
